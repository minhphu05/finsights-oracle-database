account1_tenancy_ocid        = "ocid1.tenancy.oc1..aaaaaaaar32kmxzfzptdugysbbvtijs7avyjnlg42hqec6qs2j45h7e6hatq"
account1_user_ocid           = "ocid1.user.oc1..aaaaaaaaojtx3lxugijvmm7hkkss4djkbtelqmgspyww2qjldlb3nmissmna"
account1_fingerprint         = "e6:8d:ac:81:e4:98:84:c5:57:9f:3f:41:a7:87:1d:73"
account1_region              = "ap-tokyo-1"
account1_compartment_id      = "ocid1.tenancy.oc1..aaaaaaaar32kmxzfzptdugysbbvtijs7avyjnlg42hqec6qs2j45h7e6hatq"
account1_availability_domain = "hItB:AP-TOKYO-1-AD-1"
